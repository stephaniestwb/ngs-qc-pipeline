Bootstrap: docker
From: mambaorg/micromamba:2.3.2

%labels
    Maintainer Stephanie Stamp-Wberth
    Version 0.1.0
    Description "NGS QC environment containing FastQC, fastp, and MultiQC"

%post
    micromamba install --yes \
        --name base \
        --channel conda-forge \
        --channel bioconda \
        --channel-priority strict \
        fastqc=0.12.1 \
        fastp=1.3.6 \
        multiqc=1.35

    micromamba clean --all --yes

%environment
    export PATH="/opt/conda/bin:$PATH"

%test
    echo "Testing NGS QC container..."
    fastqc --version
    fastp --version
    multiqc --version